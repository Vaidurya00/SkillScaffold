# Shared training paths for ALFWorld, WebShop, and ScienceWorld
PYTHON_BIN=/path/to/conda/envs/skillscaffold-main/bin/python
MEGATRON_DIR=/path/to/Megatron-LM
MEGATRON_LM_DIR=/path/to/Megatron-LM
HF_CHECKPOINT=/path/to/Qwen3-8B
REF_CHECKPOINT=/path/to/Qwen3-8B_torch_dist
EVAL_CHECKPOINT=/path/to/trained_megatron_checkpoint
RAY_DASHBOARD_ADDRESS=http://127.0.0.1:8265

# Optional experiment tracking; never commit the real key
WANDB_PROJECT=skillscaffold
WANDB_API_KEY=

# ALFWorld
ALFWORLD_PYTHON=/path/to/conda/envs/skillscaffold-alfworld/bin/python
ALFWORLD_CONFIG=benchmarks/alfworld/configs/alfworld.yaml
ALFWORLD_SERVER_CONFIG=benchmarks/alfworld/configs/server.yaml
ALFWORLD_DATA_ROOT=data/alfworld/task_files/json_2.1.1
ALFWORLD_PARQUET_DIR=benchmarks/alfworld/data
ALFWORLD_CACHE_FILE=benchmarks/alfworld/data/cache/unified_embeddings.npz
ALFWORLD_METHOD=group_delta
ALFWORLD_DELTA_CREDIT_SCOPE=all_model_tokens
ALFWORLD_GROUP_DELTA_VARIANT=positive_gate_trainext_raw
EXP_NAME=skillscaffold-alfworld

# WebShop
WEBSHOP_PYTHON=/path/to/conda/envs/skillscaffold-webshop/bin/python
WEBSHOP_VENDOR_ROOT=third_party/Skill0_5/agent_system/environments/env_package/webshop/webshop
WEBSHOP_DATA_DIR=third_party/Skill0_5/agent_system/environments/env_package/webshop/webshop/data
WEBSHOP_SPLITS=benchmarks/webshop/protocol/splits.json
EMBEDDING_MODEL=/path/to/embedding-model

# Tau-bench
HF_DIR=/path/to/tau-domain-sft-checkpoint-490
REF_CKPT_DIR=/path/to/tau-domain-sft-checkpoint-490-distcp
TAU2_PYTHON=/path/to/conda/envs/skillscaffold-tau/bin/python
TAU2_EVAL_PYTHON=/path/to/conda/envs/skillscaffold-tau-eval/bin/python
TAU2_BENCH_DIR=third_party/tau2-bench
TAU_RL_DATASET_REPO=wwwenlin/skillscaffold-tau-rl
TAU_DATA_REVISION=6a159820a98351861d89a9d42f551f440e43ccd3
TAU2_TRAIN_POOL_ROOT=data/tau/rl/runtime
TAU2_TRAIN_TASKS_JSONL=data/tau/rl/runtime/jsonl/three_domain_joint_family_conservative_round_robin.jsonl
TAU2_USER_API_BASE=http://127.0.0.1:3000/v1
TAU2_USER_MODEL=DeepSeek-V4-Flash
TAU2_EVAL_MODEL_DIR=/path/to/trained_hf_checkpoint
TAU2_EVAL_NUM_TRIALS=8
TAU2_EVAL_SEED=300
VLLM_BIN=/path/to/conda/envs/skillscaffold-tau-eval/bin/vllm

# ScienceWorld
SCIENCEWORLD_PYTHON=/path/to/conda/envs/skillscaffold-scienceworld/bin/python
SCIENCEWORLD_CONFIG=benchmarks/scienceworld/configs/server.yaml
JAVA_HOME=/path/to/jdk-11
SCIENCEWORLD_TRAIN_DATA=data/scienceworld/train.parquet
SCIENCEWORLD_EVAL_ID_DATA=data/scienceworld/test_id_dev230.parquet
SCIENCEWORLD_EVAL_OOD_DATA=data/scienceworld/test_ood155.parquet
